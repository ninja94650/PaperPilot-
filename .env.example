# Supabase Auth and private document library
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional isolated LibreOffice worker. Keep the token server-side only.
DOCUMENT_WORKER_URL=
DOCUMENT_WORKER_TOKEN=

